{
  "name": "dsh-effort-router",
  "version": "0.2.9",
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH plugin: context-aware per-step reasoning-effort routing (the drift engine). Classifies the task origin once (trivial/standard/engineering/hard) from the originating brief, then drifts the class on stacked evidence: a decay-weighted short window of tool errors / repeats / todo completions / failure carry, a long window of gzip-discounted information volume on linear ramps, and real-time frugal signals — no hysteresis. Clamps to the target model's advertised efforts and injects an 'Auto' mask into the native model selector. Fills default reasoningEfforts for hand-declared llm-pi-ai custom models. All user-facing options live in the plugin config file (no settings UI); the GUI surfaces (composer badge, trajectory hoisting) are read-only displays.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./policy": "./lib/policy.js",
    "./routing": "./lib/routing.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test",
    "prepack": "node build-client.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.2.1-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.2.1-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.2.1-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "plugin",
    "cordis",
    "reasoning-effort",
    "thinking-level",
    "effort-router",
    "auto-effort"
  ],
  "license": "MIT",
  "author": "kimi-k3 (AI author), produced by KEI.NEO (@neo805)",
  "packageManager": "pnpm@11.18.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neo805/dsh-effort-router.git"
  },
  "homepage": "https://github.com/neo805/dsh-effort-router#readme"
}
